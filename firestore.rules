rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExistingGoal() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsNewGoal() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /goals/{goalId} {
      allow create: if ownsNewGoal();
      allow read, update, delete: if ownsExistingGoal();
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
