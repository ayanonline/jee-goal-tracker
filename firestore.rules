rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Match all documents in the users collection
    match /users/{userId} {
      // Allow read/write access to the user's own document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Nested goals collection
      match /goals/{goalId} {
        // Allow read/write access to the user's own goals
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Default deny all other operations
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
